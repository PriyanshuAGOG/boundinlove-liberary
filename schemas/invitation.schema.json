{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invitation-factory.local/schemas/invitation.schema.json",
  "title": "Invitation Project",
  "type": "object",
  "required": ["slug", "eventType", "locale", "hosts", "events", "theme"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "eventType": { "type": "string" },
    "locale": { "type": "string", "default": "en-IN" },
    "timezone": { "type": "string", "default": "Asia/Kolkata" },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "portrait": { "type": ["string", "null"] }
        }
      }
    },
    "headline": { "type": "string" },
    "message": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "start", "venue"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": ["string", "null"], "format": "date-time" },
          "venue": {
            "type": "object",
            "required": ["name", "address"],
            "properties": {
              "name": { "type": "string" },
              "address": { "type": "string" },
              "mapUrl": { "type": ["string", "null"], "format": "uri" }
            }
          },
          "dressCode": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "accentId": { "type": ["string", "null"] },
        "overrides": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "story": { "type": "array", "items": { "type": "object" } },
    "gallery": { "type": "array", "items": { "type": "object" } },
    "rsvp": { "type": "object" },
    "audio": { "type": ["object", "null"] },
    "branding": {
      "type": "object",
      "properties": {
        "showFactoryCredit": { "type": "boolean", "default": true },
        "factoryUrl": { "type": ["string", "null"], "format": "uri" }
      }
    }
  },
  "additionalProperties": true
}

